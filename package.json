{
  "name": "leave-management-system",
  "version": "1.0.0",
  "description": "Employee Leave Management System - CI/CD demo with Jenkins and Docker",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --ci --coverage"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongoose": "^8.9.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "reports/coverage",
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js", "!src/stores/mongoStore.js"],
    "reporters": [
      "default",
      ["jest-junit", { "outputDirectory": "reports", "outputName": "junit.xml" }]
    ]
  }
}
